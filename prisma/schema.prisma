generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sale {
  id            String   @id @default(uuid())
  transactionId String   @unique
  status        String   // "approved", "refused", "refunded"
  amount        Float
  customerEmail String
  productName   String
  createdAt     DateTime @default(now())
}